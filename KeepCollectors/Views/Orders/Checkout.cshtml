@model DataAccessLayer.DataModels.Cart

@{
    decimal subtotal = 0;

    if (Model != null && Model.CartItems != null)
    {
        subtotal = Model.CartItems.Sum(item => item.Product.Price * item.Quantity);
    }

    decimal tax = Math.Round(subtotal * 0.08m, 2);
    decimal total = subtotal + tax;
}

<div class="container checkout-container mt-5">

    <h2 class="mb-4 text-center">Secure Checkout</h2>

    @if (Model == null || Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="text-center mt-5">
            <p class="fs-5 text-muted">Your cart is empty.</p>
        </div>
    }
    else
    {
        <div class="row g-4">

            <!-- LEFT SIDE (Products) -->
            <div class="col-lg-8">
                @foreach (var item in Model.CartItems)
                {
                    var lineTotal = item.Product.Price * item.Quantity;

                    <div class="card mb-3 p-3 d-flex flex-row align-items-center gap-3">

                        <!-- IMAGE -->
                        <img src="@item.Product.ImagePath"
                             alt="@item.Product.Name"
                             class="checkout-img" />

                        <!-- DETAILS -->
                        <div class="flex-grow-1">
                            <h5 class="mb-1">@item.Product.Name</h5>
                            <p class="mb-1 text-muted">Price: $@item.Product.Price</p>
                            <p class="mb-0 text-muted">Quantity: @item.Quantity</p>
                        </div>

                        <!-- TOTAL -->
                        <div>
                            <strong>$@lineTotal</strong>
                        </div>

                    </div>
                }
            </div>

            <!-- RIGHT SIDE (Summary) -->
            <div class="col-lg-4">
                <div class="card p-4 checkout-summary">

                    <h4 class="mb-3">Order Summary</h4>

                    <p>Subtotal: $@subtotal</p>
                    <p>Tax: $@tax</p>

                    <hr />

                    <h5>Total: $@total</h5>

                    <form asp-action="PlaceOrder" method="post">
                        <button type="submit" class="btn btn-success w-100 mt-3">
                            Pay $@total
                        </button>
                    </form>

                </div>
            </div>

        </div>
    }

</div>