@model List<DataAccessLayer.DataModels.Post>

<div class="container community-container mt-5">

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <!-- Create Post -->
    <div class="card p-3 mb-4">
        <div id="post-error" class="text-danger text-center mb-2"></div>
        <form id="create-post-form" asp-action="CreatePost" method="post" enctype="multipart/form-data">

            <textarea name="content" class="form-control mb-2"
                      placeholder="Share something..."></textarea>

            <input type="file" name="image" class="form-control mb-2" />

            <button class="btn btn-primary">Post</button>
        </form>
    </div>

    <!-- Feed -->
    @foreach (var post in Model)
    {
        <div class="card mb-4 p-3">

            <strong>@post.User.UserName</strong>
            <small class="text-muted">@post.CreatedAt</small>

            <p class="mt-2">@post.Content</p>

            @if (!string.IsNullOrEmpty(post.ImagePath))
            {
                <img src="@post.ImagePath" class="img-fluid mb-2" />
            }

            <!-- Likes -->
            <form asp-action="Like" method="post">
                <input type="hidden" name="postId" value="@post.PostId" />
                <button class="btn btn-sm btn-outline-primary">
                    Like (@post.Likes.Count)
                </button>
            </form>

            <!-- Comments -->
            <div class="mt-3">
                @foreach (var comment in post.Comments)
                {
                    <p><strong>@comment.User.UserName:</strong> @comment.Content</p>
                }

                <form asp-action="AddComment" method="post">
                    <input type="hidden" name="postId" value="@post.PostId" />
                    <input type="text" name="content" class="form-control"
                           placeholder="Add a comment..." />
                </form>
            </div>

        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.querySelector("#create-post-form");
            const errorDiv = document.getElementById("post-error");
            const textarea = document.querySelector("textarea[name='content']");

            form.addEventListener("submit", function (e) {

                const content = textarea.value.trim();
                const image = document.querySelector("input[name='image']").files.length;

                errorDiv.textContent = "";
                textarea.classList.remove("border-danger");

                if (!content && image === 0) {
                    e.preventDefault();

                    // Error Message
                    errorDiv.textContent = "Your post must include text or an image.";

                    // Highlight textarea
                    textarea.classList.add("border-danger");

                    // Shake form
                    form.classList.remove("shake");
                    void form.offsetWidth;
                    form.classList.add("shake");
                }
            });
        });
    </script>
}
