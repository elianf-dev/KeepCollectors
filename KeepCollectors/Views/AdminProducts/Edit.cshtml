@model KeepCollectors.Models.AdminProductsEditViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<h2 class="mb-3">Edit Product</h2>

@if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath))
{
    <div class="mb-3">
        <div class="text-muted">Current Image:</div>
        <img src="@Model.ExistingImagePath" style="height:120px; object-fit:cover;" />
    </div>
}

<form asp-action="Edit" asp-route-id="@Model.ProductID" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ProductID" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="QuantityAvailable" class="form-label"></label>
            <input asp-for="QuantityAvailable" class="form-control" />
            <span asp-validation-for="QuantityAvailable" class="text-danger"></span>
        </div>
    </div>

    <hr />

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" placeholder="Paste a new URL to replace the image (optional)" />
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label"></label>
        <input asp-for="ImageFile" class="form-control" type="file" />
        <div class="text-muted small">Upload a file to replace the image (optional).</div>
    </div>

    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}