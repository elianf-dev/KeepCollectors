@model IEnumerable<DataAccessLayer.DataModels.Product>

@{
    ViewData["Title"] = "Admin - Products";
}

<h2 class="mb-3">Admin - Products</h2>

<p>
    <a class="btn btn-success" asp-action="Create">+ Add Product</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Price</th>
            <th>Qty</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td style="width:120px;">
                    <img src="@(string.IsNullOrWhiteSpace(p.ImagePath) ? "/images/products/placeholder.png" : p.ImagePath)"
                         style="height:60px; object-fit:cover;" />
                </td>
                <td>@p.Name</td>
                <td>$@p.Price</td>
                <td>@p.QuantityAvailable</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@p.ProductID">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>