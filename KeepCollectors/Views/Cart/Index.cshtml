@model DataAccessLayer.DataModels.Cart
@{
    decimal total = 0;
}


<div class="container cart-container mt-5">

    <h2 class="mb-4 text-center">Your Cart</h2>

    @if (Model?.CartItems?.Any() == true)
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th style="width:150px;">Price</th>
                    <th style="width:120px;">Quantity</th>
                    <th style="width:120px;"></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    var subtotal = item.Product.Price * item.Quantity;
                    total += subtotal;
                    <tr>
                        <td>@item.Product.Name</td>

                        <td>$@item.Product.Price</td>

                        <td>@item.Quantity</td>


                        <td>
                            <form asp-controller="Cart" asp-action="Remove" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.CartItemID" />
                                <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                            </form>
                            
                        </td>
                        <td> </td>
                    </tr>
                }
            </tbody>
        </table>

        <h6>Total: $@total.ToString("F2")</h6>
        <a asp-controller="Orders" asp-action="Checkout"
              class="btn btn-primary mt-3">
              Proceed to Checkout 
        </a>

        
    }
    else
    {
        <div class="text-center mt-5">

            <p class="fs-5 text-muted">
                Your cart is currently empty.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary-two mt-3">
                Browse Products
            </a>

        </div>
    }

</div>
