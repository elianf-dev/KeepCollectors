@model IEnumerable<DataAccessLayer.DataModels.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Browse Products</h2>

    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="product-card border box-shadow h-100">

                    <div class="product-img-wrapper">
                        <img src="@(string.IsNullOrEmpty(product.ImagePath)
                                                                                              ? "/images/placeholder.png"
                                                                                              : product.ImagePath)"
                             class="product-img"
                             alt="@product.Name" />
                    </div>

                    <div class="p-3 text-center">
                        <h5 class="mb-2">@product.Name</h5>

                        <p class="product-price fw-bold mb-2">
                            $@product.Price.ToString("F2")
                        </p>

                        <div class="d-flex justify-content-center gap-2">

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.ProductID"
                               class="btn btn-primary btn-sm">
                                View Item
                            </a>

                            <a asp-controller="Cart"
                               asp-action="AddToCart"
                               asp-route-productId="@product.ProductID"
                               class="btn btn-outline-primary btn-sm">
                                Add to Cart
                            </a>

                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>