@model IEnumerable<DataAccessLayer.DataModels.Product>

@{
    ViewData["Title"] = "Products";

    var category = Context.Request.Query["category"];
}

<div class="container mt-4">
    <h2 class="text-center mt-4">
        @(string.IsNullOrEmpty(category) || category == "All"
                ? "All Products"
                : "Browse " + category)
    </h2>

    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="product-card border box-shadow h-100">

                    <div class="product-img-wrapper">
                        <img src="@(string.IsNullOrEmpty(product.ImagePath)
                                                                ? "/images/placeholder.png"
                                                                : product.ImagePath)"
                         class="product-img"
                         alt="@product.Name" />
                </div>

                    <div class="p-3 text-center">
                        <h5 class="mb-2">@product.Name</h5>

                        <p class="product-price fw-bold mb-2">
                            $@product.Price.ToString("F2")
                        </p>

                        <p class="text-muted mb-2">In Stock: @product.QuantityAvailable</p>

                        <div class="d-flex justify-content-center gap-2">

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.ProductID"
                               class="btn btn-primary btn-sm">
                                View Item
                            </a>

                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@product.ProductID" />
                                <input type="hidden" name="quantity" value="1" />

                                <button type="submit" class="btn btn-primary-two btn-sm">
                                    Add to Cart
                                </button>
                            </form>

                        </div>
                    </div>

                </div>
            </div>
                }
    </div>
</div>