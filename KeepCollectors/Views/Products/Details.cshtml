@model DataAccessLayer.DataModels.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">

    <div class="row">

        <!-- Image -->
        <div class="col-md-6">
            <div class="product-card border box-shadow p-3">
                <div class="product-img-wrapper">
                    <img src="@(string.IsNullOrEmpty(Model.ImagePath)
                                                          ? "/images/placeholder.png"
                                                          : Model.ImagePath)"
                         class="product-img"
                         alt="@Model.Name" />
                </div>
            </div>
        </div>

        <!-- Product Info -->
        <div class="col-md-6">

            <h2 class="mb-3">@Model.Name</h2>

            <p class="mb-3">
                @Model.Description
            </p>

            <h4 class="product-price mb-3">
                $@Model.Price.ToString("F2")
            </h4>

            <p class="mb-3">
                <strong>Quantity Available:</strong>
                @Model.Inventory?.Quantity
            </p>

            <button class="btn btn-primary">
                Add to Cart
            </button>

        </div>

    </div>

</div>
