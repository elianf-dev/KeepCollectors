@model List<DataAccessLayer.DataModels.Product>

@{
    ViewData["Title"] = "Collectors Keep";
}

<div class="embla">

    <div class="embla__viewport">
        <div class="embla__container">

            <div class="embla__slide">
                <img src="~/images/carousel/product1.jpg">
            </div>

            <div class="embla__slide">
                <img src="~/images/carousel/product2.jpg">
            </div>

            <div class="embla__slide">
                <img src="~/images/carousel/product3.jpg">
            </div>

            <div class="embla__slide">
                <img src="~/images/carousel/product4.jpg">
            </div>

       </div>
    </div>
    

    <button class="embla__prev">‹</button>
    <button class="embla__next">›</button>

    <div class="embla__dots"></div>

</div>

<div class="container mt-4">

    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5">User Sellers</h1>
        <p class="text-muted">Discover rare and valuable collectibles</p>
    </div>

    <!-- Product Grid -->
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm">

                    <img src="@(string.IsNullOrWhiteSpace(p.ImagePath)
                                                                          ? "https://via.placeholder.com/600x400?text=No+Image"
                                                                          : p.ImagePath)"
                         class="card-img-top"
                         style="height: 220px; object-fit: cover;"
                         alt="@p.Name" />

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title fw-semibold">@p.Name</h5>

                        <p class="card-text text-muted">
                            @(string.IsNullOrWhiteSpace(p.Description)
                                                    ? "No description available."
                                                    : (p.Description.Length > 90
                                                    ? p.Description.Substring(0, 90) + "..."
                                                    : p.Description))
                        </p>
                        <p class="text-muted mb-2">In Stock: @p.QuantityAvailable</p>


                        <div class="mt-auto d-grid">
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@p.ProductID"
                               class="btn btn-primary btn-sm">
                                View Details
                            </a>
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@p.ProductID" />
                                            <input type="hidden" name="quantity" value="1" />

                                            <button type="submit" class="btn btn-primary-two w-100">
                                                Add to Cart
                                            </button>
                                        </form>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>
