<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KeepCollectors</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KeepCollectors.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)

</head>
    <body class="@(Context.Request.Path.StartsWithSegments("/Identity") ? "identity-ui" : "")">
        <header>
        @{
            var currentCategory = Context.Request.Query["category"].ToString();
        }
            <nav class="navbar top-bar border-bottom">
                <div class="container-fluid">
                    <div class="row w-100 align-items-center">

                        <div class="col-4 d-flex align-items-center">
                            <a class="navbar-brand text-white fw-bold logo-text m-0" asp-controller="Home" asp-action="Index">
                                The Collectors Keep
                                <img src="~/images/CastleLogoFinal.png" alt="Logo" height="40" class="ms-2" />
                            </a>
                        </div>

                        <div class="col-4 text-center">
                            <form>
                                <input class="form-control w-75 mx-auto" type="search" placeholder="Search products..." />
                            </form>
                        </div>

                        <div class="col-4 d-flex justify-content-end gap-3">
                            <a class="btn text-white btn-outline-light top-bar-btn" asp-controller="Cart" asp-action="Index">Cart</a>
                            <a class="btn text-white btn-outline-light top-bar-btn" asp-controller="Keep" asp-action="Index">My Keep</a>
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <a class="btn text-white btn-outline-light top-bar-btn"
                                   asp-area="Identity" asp-page="/Account/Manage/Index">
                                    My Account
                                </a>

                                <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
                                    <button type="submit" class="btn text-white btn-outline-light top-bar-btn">
                                        Logout
                                    </button>
                                </form>
                                    <a class="btn text-white btn-outline-light top-bar-btn"
                                     asp-controller="Orders"
                                    asp-action="History">
                                        Orders
                                </a>

                            }
                            else
                            {
                                <a class="btn text-white btn-outline-light top-bar-btn"
                                   href="/Identity/Account/Login">
                                    Log in/Register
                                </a>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn text-white btn-outline-light top-bar-btn"
                                asp-controller="AdminProducts" asp-action="Index">Admin</a>
                            }

                            @*@ <a class="btn text-white btn-outline-light top-bar-btn" asp-controller="Account" data-bs-toggle="modal" data-bs-target="#accountModal" asp-action="Index">Account</a>*@
                    
                        </div>
                    </div>
                </div>
            </nav>

            <nav class="navbar navbar-expand category-bar">
                <div class="container-fluid justify-content-center">
                    <ul class="navbar-nav gap-4">
                        <li class="nav-item bottom-bar-btn">
                        <a class="nav-link text-decoration-none text-white @(currentCategory == "Cards" ? "active-category" : "")"
                               asp-controller="Products"
                               asp-action="Index"
                               asp-route-category="Cards">
                                Cards
                            </a>
                        </li>
                        <li class="nav-item bottom-bar-btn">
                        <a class="nav-link text-decoration-none text-white @(currentCategory == "ActionFigures" ? "active-category" : "")"
                               asp-controller="Products"
                               asp-action="Index"
                               asp-route-category="ActionFigures">
                                Action Figures
                            </a>
                        </li>
                        <li class="nav-item bottom-bar-btn">
                        <a class="nav-link text-decoration-none text-white @(currentCategory == "Comics" ? "active-category" : "")"
                               asp-controller="Products"
                               asp-action="Index"
                               asp-route-category="Comics">
                                Comics
                            </a>
                        </li>
                        <li class="nav-item bottom-bar-btn">
                        <a class="nav-link text-decoration-none text-white @(currentCategory == "RetroGames" ? "active-category" : "")"
                               asp-controller="Products"
                               asp-action="Index"
                               asp-route-category="RetroGames">
                                Retro Games
                            </a>
                        </li>
                        <li class="nav-item bottom-bar-btn">
                        <a class="nav-link text-decoration-none text-white @(currentCategory == "Vinyl" ? "active-category" : "")"
                               asp-controller="Products"
                               asp-action="Index"
                               asp-route-category="Vinyl">
                                Vinyl
                            </a>
                        </li>
                        <li class="nav-item bottom-bar-btn"><a class="nav-link text-decoration-none text-white" href="#">Community Posts</a></li>
                    <li class="nav-item bottom-bar-btn">
                        <a class="nav-link text-decoration-none text-white"
                            asp-controller="Leaderboard"
                            asp-action = "Index">
                            Leaderboard
                        </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>
        <div class="container-fluid px-0">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - TheCollectorsKeep - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)

    <script src="https://unpkg.com/embla-carousel/embla-carousel.umd.js"></script>
    </body>
</html>