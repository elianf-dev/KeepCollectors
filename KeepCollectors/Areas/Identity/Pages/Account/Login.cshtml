@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container login-container mt-5">

    <div class="text-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <p class="text-muted">Welcome back to The Collectors Keep</p>
    </div>

    <div class="row justify-content-center g-4">

        <!-- LOGIN FORM -->
        <div class="col-lg-5">
            <div class="card p-4 login-card">

                <form id="account" method="post">

                    <h4 class="mb-3">Sign In</h4>
                    <hr />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email"
                               class="form-control"
                               placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email"
                              class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password"
                               class="form-control"
                               placeholder="Password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input"
                               asp-for="Input.RememberMe" />
                        <label class="form-check-label"
                               asp-for="Input.RememberMe">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>

                    <button id="login-submit"
                            type="submit"
                            class="btn btn-primary w-100">
                        Log in
                    </button>

                    <div class="mt-3 small text-center">
                        <a asp-page="./ForgotPassword">Forgot password?</a><br />
                        <a asp-page="./Register"
                           asp-route-returnUrl="@Model.ReturnUrl">
                            Create an account
                        </a><br />
                        <a asp-page="./ResendEmailConfirmation">
                            Resend confirmation
                        </a>
                    </div>

                </form>

            </div>
        </div>

        <!-- EXTERNAL LOGIN -->
        <div class="col-lg-5">
            <div class="card p-4 login-card">

                <h4>Use another service</h4>
                <hr />

                @{
                    if ((Model.ExternalLogins?.Count ?? 0) == 0)
                    {
                        <p class="text-muted">
                            No external authentication services configured.
                        </p>
                    }
                    else
                    {
                        <form id="external-account"
                              asp-page="./ExternalLogin"
                              asp-route-returnUrl="@Model.ReturnUrl"
                              method="post">

                            <div class="d-grid gap-2">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit"
                                            class="btn btn-outline-primary"
                                            name="provider"
                                            value="@provider.Name">
                                        Continue with @provider.DisplayName
                                    </button>
                                }
                            </div>
                        </form>
                    }
                }

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
