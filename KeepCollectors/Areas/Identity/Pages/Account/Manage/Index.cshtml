@page
@model KeepCollectors.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Profile";
}

<div class="manage-page">
    <div class="manage-header">
        <h1 class="manage-title">My Profile</h1>
        <p class="manage-subtitle">Update your account information.</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="manage-card">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control keep-input" disabled />
                <label asp-for="Username"></label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control keep-input" />
                <label asp-for="Input.PhoneNumber"></label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <button id="update-profile-button" type="submit" class="keep-btn">
                Save Changes
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}